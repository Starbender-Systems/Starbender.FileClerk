<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageReference Include="IdentityModel" Version="7.0.0" />
    <PackageReference Include="KubernetesClient" Version="18.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.Basic" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Web" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Identity.Web" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Web" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.Web" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" Version="3.0.8" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.Web" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Starbender.FileClerk.Web\Starbender.FileClerk.Web.csproj" />
    <ProjectReference Include="..\..\shared\Starbender.FileClerk.Demo.Application\Starbender.FileClerk.Demo.Application.csproj" />
    <ProjectReference Include="..\..\shared\Starbender.FileClerk.Demo.EntityFrameworkCore\Starbender.FileClerk.Demo.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\shared\Starbender.FileClerk.Demo.HttpApi\Starbender.FileClerk.Demo.HttpApi.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('./openiddict.pfx')">
    <None Remove="openiddict.pfx" />
    <EmbeddedResource Include="openiddict.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\blazor-server\Starbender.FileClerk.Demo.BlazorServer\wwwroot\images\getting-started\**\*">
      <Link>wwwroot\images\getting-started\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\**\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
