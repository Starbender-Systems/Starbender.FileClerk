@page
@using Volo.Abp.Users
@model Starbender.FileClerk.Demo.Web.Pages.IndexModel
@inject IHtmlLocalizer<DemoResource> L
@inject ICurrentUser CurrentUser

@section styles {
    <abp-style src="/Pages/Index.cshtml.css" />
}

<div class="getting-started-page">
    <div class="row mb-3">
        <div class="col-xl-6 col-12 d-flex">
            <div class="card h-lg-100 w-100 overflow-hidden getting-started-hero-card">
                <div class="card-body">
                    <div class="starting-content pe-5">
                        @if (!CurrentUser.IsAuthenticated)
                        {
                            <h3>@L["Welcome"]</h3>
                            <p class="lead text-muted mb-2">@L["LongWelcomeMessage"]</p>
                            <a href="/Account/Login" class="btn btn-primary mb-4">
                                <i class="fa-solid fa-right-to-bracket me-1"></i>
                                <span>@L["Login"]</span>
                            </a>
                        }

                        <h4>Getting Started</h4>
                        <p class="text-muted mb-2">Learn how to create and run a new web application using the ABP application startup template.</p>
                        <a href="https://abp.io/docs/latest/get-started" class="btn btn-primary mb-4" target="_blank" rel="noopener">Getting Started</a>

                        <h4>Web Application Development Tutorial</h4>
                        <p class="text-muted mb-2">Learn how to build an ABP-based web application with MVC and Entity Framework Core.</p>
                        <a href="https://abp.io/docs/latest/tutorials/book-store?UI=MVC&DB=EF" class="btn btn-primary soft mb-4" target="_blank" rel="noopener">Explore Tutorial</a>
                    </div>
                    <img class="card-bg-image" src="/images/getting-started/bg-01.png" alt="" />
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 d-flex pe-xl-0">
            <div class="row w-100">
                <div class="col-12 d-flex pe-0">
                    <div class="card w-100 overflow-hidden">
                        <div class="card-body pb-0">
                            <div class="abp-support abp-logo mb-2"></div>
                            <p class="text-muted mb-2">Find answers to similar questions or start a discussion about a specific problem.</p>
                            <a href="https://abp.io/support/questions" class="btn btn-primary soft" target="_blank" rel="noopener">Visit Support</a>
                            <img src="/images/getting-started/img-support.png" alt="" />
                        </div>
                    </div>
                </div>
                <div class="col-12 d-flex pe-0">
                    <div class="card h-md-100 w-100 overflow-hidden">
                        <div class="card-body pb-0">
                            <div class="abp-blog abp-logo mb-2"></div>
                            <p class="text-muted mb-2">Read about .NET, cross-platform development, ABP news, and application design.</p>
                            <a href="https://abp.io/blog" class="btn btn-primary soft" target="_blank" rel="noopener">Visit Blog</a>
                            <img class="template-card-image" src="/images/getting-started/img-blog.png" alt="" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 d-flex">
            <div class="card h-100 w-100 overflow-hidden">
                <div class="card-body">
                    <div class="abp-community abp-logo mb-2"></div>
                    <p class="lead text-muted">A community platform for <span class="fw-bold">ABP developers.</span></p>
                    <p class="text-muted mb-2">Discover articles and videos, exchange experiences, and meet other ABP users.</p>
                    <a class="btn btn-primary soft mb-3" href="https://abp.io/community/" target="_blank" rel="noopener">Join ABP Community</a>
                </div>
                <img class="mt-3 img-fluid" src="/images/getting-started/img-community.png" alt="" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card h-100">
                <div class="card-header"><div class="card-title text-body">More from ABP.IO</div></div>
                <div class="card-body pt-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0"><a href="https://github.com/abpframework/abp/releases" target="_blank" rel="noopener">Latest release notes</a></li>
                        <li class="list-group-item px-0"><a href="https://abp.io/video-courses/essentials" target="_blank" rel="noopener">Video courses</a></li>
                        <li class="list-group-item px-0"><a href="https://abp.io/docs/latest/samples" target="_blank" rel="noopener">Samples</a></li>
                        <li class="list-group-item px-0"><a href="https://abp.io/books" target="_blank" rel="noopener">Books</a></li>
                        <li class="list-group-item px-0"><a href="https://abp.io/faq" target="_blank" rel="noopener">FAQ</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-lg-8 col-md-6 d-flex">
            <div class="card h-100 w-100">
                <div class="card-body d-flex">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <p class="text-muted mb-0">THE OFFICIAL GUIDE</p>
                            <h3>Mastering ABP Framework</h3>
                            <p class="text-muted">Build a complete understanding of the framework and modern web application development techniques.</p>
                            <a href="https://www.amazon.com/gp/product/B097Z2DM8Q" target="_blank" rel="noopener" class="btn btn-primary soft">Buy on Amazon</a>
                        </div>
                        <div class="col-md-4 text-center">
                            <img src="/images/getting-started/book.png" class="img-fluid" alt="Mastering ABP Framework book" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card h-100">
                <div class="card-header"><div class="card-title text-body">Demo technology</div></div>
                <div class="card-body">
                    <p class="text-muted">This application exercises the FileClerk MVC integration against the shared PostgreSQL backend.</p>
                    <div class="mvc-razor-pages mb-3" aria-label="MVC Razor Pages"></div>
                    <div class="entity-famework-core" aria-label="Entity Framework Core"></div>
                </div>
            </div>
        </div>
    </div>
</div>
