{
  "App": {
    "SelfUrl": "http://localhost:8085",
    "RedirectAllowedUrls": "http://localhost:8085",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System.Net.Http.HttpClient.health-checks": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            { "Name": "File", "Args": { "path": "Logs/logs.txt" } },
            { "Name": "Console" }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=fileclerk;Username=fileclerk;Password=fileclerk_dev_only",
    "FileClerk": "Host=postgres;Port=5432;Database=fileclerk;Username=fileclerk;Password=fileclerk_dev_only"
  },
  "AuthServer": {
    "Authority": "http://localhost:8085",
    "RequireHttpsMetadata": false,
    "CertificatePassPhrase": "fileclerk-demo-openiddict"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "fileclerk-demo-string-encryption"
  }
}
