{
  "App": {
    "SelfUrl": "http://localhost:8081",
    "RedirectAllowedUrls": "http://localhost:8081",
    "DisablePII": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=fileclerk;Username=fileclerk;Password=fileclerk_dev_only",
    "FileClerk": "Host=postgres;Port=5432;Database=fileclerk;Username=fileclerk;Password=fileclerk_dev_only"
  },
  "AuthServer": {
    "Authority": "http://localhost:8081",
    "RequireHttpsMetadata": false,
    "CertificatePassPhrase": "fileclerk-demo-openiddict"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "fileclerk-demo-string-encryption"
  }
}
